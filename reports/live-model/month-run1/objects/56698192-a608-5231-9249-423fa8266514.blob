{"$schema":"https://json-schema.org/draft/2020-12/schema","$defs":{"ConsciousnessDraft":{"additionalProperties":false,"properties":{"brief_summary":{"maxLength":4096,"type":"string"},"extensions":{"additionalProperties":{"type":"object"},"propertyNames":{"pattern":"^[a-z][a-z0-9_]*\\.[a-z][a-z0-9_.]*$"},"type":"object"},"focal_goals":{"items":{"$ref":"#/$defs/FocusEntry"},"maxItems":20,"type":"array"},"important_changes":{"items":{"$ref":"#/$defs/FocusEntry"},"maxItems":50,"type":"array"},"open_loops":{"items":{"$ref":"#/$defs/FocusEntry"},"maxItems":50,"type":"array"},"priority_items":{"items":{"$ref":"#/$defs/FocusEntry"},"maxItems":20,"type":"array"},"schema_version":{"const":1},"uncertainties":{"items":{"type":"string"},"maxItems":30,"type":"array"}},"required":["schema_version","focal_goals","priority_items","open_loops","important_changes","uncertainties","brief_summary","extensions"],"type":"object"},"EvidenceRef":{"additionalProperties":false,"properties":{"data_class":{"enum":["SYNTHETIC","PERSONAL","SENSITIVE","SECRET"],"type":"string"},"locator":{"type":"string"},"object_id":{"format":"uuid","type":"string"},"origin_id":{"type":"string"},"sha256":{"pattern":"^[0-9a-f]{64}$","type":"string"}},"required":["object_id","sha256","locator","origin_id","data_class"],"type":"object"},"FocusEntry":{"additionalProperties":false,"properties":{"entity":{"$ref":"#/$defs/ReadRef"},"evidence":{"items":{"$ref":"#/$defs/EvidenceRef"},"maxItems":100,"type":"array"},"reason":{"maxLength":1024,"type":"string"}},"required":["entity","reason","evidence"],"type":"object"},"ReadRef":{"additionalProperties":false,"properties":{"entity_type":{"type":"string"},"id":{"format":"uuid","type":"string"},"revision":{"minimum":1,"type":"integer"}},"required":["entity_type","id","revision"],"type":"object"}},"$ref":"#/$defs/ConsciousnessDraft","$schema":"https://json-schema.org/draft/2020-12/schema"}